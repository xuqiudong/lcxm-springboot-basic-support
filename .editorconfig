# LCXM 的跨编辑器基础格式配置。
# IntelliJ IDEA 用户也可导入 config/idea/lcxm-idea-style.xml；两份配置中的 Java 规则应保持一致。
# 本文件存在时，其中已声明的选项优先于 IDEA Code Style Scheme 的对应选项。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 4
ij_continuation_indent_size = 8
max_line_length = 120

# IDEA 格式化 Java 代码时，以 120 字符右边界为目标拆分常见的长表达式。
ij_java_wrap_long_lines = true
ij_java_call_parameters_wrap = normal
ij_java_method_parameters_wrap = normal
ij_java_method_call_chain_wrap = normal
ij_java_binary_operation_wrap = normal
ij_java_assignment_wrap = normal
ij_java_for_statement_wrap = normal
ij_java_annotation_parameter_wrap = normal

# IDEA 不自动生成星号 import，与 Checkstyle 的 AvoidStarImport 保持一致。
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999

# IDEA 优化 import 时按第三方、javax、java、静态 import 分组，各组之间保留空行。
ij_java_imports_layout = *,|,javax.**,|,java.**,|,$*

[*.{xml,yml,yaml,properties}]
indent_style = space
indent_size = 4
