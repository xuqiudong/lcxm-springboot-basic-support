<?xml version="1.0" encoding="UTF-8"?>
<!--
    LCXM 的 IntelliJ IDEA Java Code Style Scheme。
    Java 格式规则与仓库根目录的 .editorconfig 保持一致；修改任一文件时应同步检查另一份配置。
    编码、LF、文件末尾换行和行尾空格等文件级规则仅由 .editorconfig 统一管理。
-->
<code_scheme name="LCXM" version="173">
    <option name="RIGHT_MARGIN" value="120"/>
    <JavaCodeStyleSettings>
        <!-- 禁止 IDEA 自动生成星号 import。 -->
        <option name="CLASS_COUNT_TO_USE_IMPORT_ON_DEMAND" value="999"/>
        <option name="NAMES_COUNT_TO_USE_IMPORT_ON_DEMAND" value="999"/>
        <!-- 普通第三方、javax、java、静态 import 分组，各组之间保留空行。 -->
        <option name="IMPORT_LAYOUT_TABLE">
            <value>
                <package name="" withSubpackages="true" static="false"/>
                <emptyLine/>
                <package name="javax" withSubpackages="true" static="false"/>
                <emptyLine/>
                <package name="java" withSubpackages="true" static="false"/>
                <emptyLine/>
                <package name="" withSubpackages="true" static="true"/>
            </value>
        </option>
    </JavaCodeStyleSettings>
    <codeStyleSettings language="JAVA">
        <option name="RIGHT_MARGIN" value="120"/>
        <option name="WRAP_LONG_LINES" value="true"/>
        <option name="CALL_PARAMETERS_WRAP" value="1"/>
        <option name="METHOD_PARAMETERS_WRAP" value="1"/>
        <option name="METHOD_CALL_CHAIN_WRAP" value="1"/>
        <option name="BINARY_OPERATION_WRAP" value="1"/>
        <option name="ASSIGNMENT_WRAP" value="1"/>
        <option name="FOR_STATEMENT_WRAP" value="1"/>
        <option name="ANNOTATION_PARAMETER_WRAP" value="1"/>
        <!-- 类的 extends/implements 列表和方法的 throws 列表超过右边界时按需换行。 -->
        <option name="EXTENDS_LIST_WRAP" value="1"/>
        <option name="THROWS_LIST_WRAP" value="1"/>
        <indentOptions>
            <option name="USE_TAB_CHARACTER" value="false"/>
            <option name="TAB_SIZE" value="4"/>
            <option name="INDENT_SIZE" value="4"/>
            <option name="CONTINUATION_INDENT_SIZE" value="8"/>
        </indentOptions>
    </codeStyleSettings>
</code_scheme>
