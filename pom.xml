<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.xuqiudong.basic</groupId>
    <artifactId>lcxm-springboot-parent</artifactId>
    <version>4.0.0</version>
    <packaging>pom</packaging>

    <!-- 项目发布元数据 -->
    <name>lcxm-springboot-basic-support</name>
    <description>面向 Spring Boot 3.5 / JDK 21 的可复用基础能力模块集合</description>
    <url>https://gitee.com/xuqiudong/${project.git.name}</url>

    <modules>
        <module>lcxm-basic-core</module>
        <module>lcxm-basic-excel</module>
        <module>lcxm-basic-framework</module>
        <module>lcxm-basic-mybatis-plus</module>
        <module>lcxm-basic-srpc</module>
        <module>lcxm-basic-third</module>
        <module>lcxm-trial</module>
        <module>lcxm-spring-boot-starters</module>
        <module>lcxm-basic-secure-id</module>
    </modules>

    <properties>
        <!-- 父项目 SCM 元数据使用的仓库名；子项目发布自己的仓库时可以覆盖。 -->
        <project.git.name>lcxm-springboot-basic-support</project.git.name>
        <spring.boot.version>3.5.16</spring.boot.version>

        <!-- Maven 构建阶段读取和写入资源时使用的字符集。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Maven 生成站点、报告和文档时使用的字符集。 -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- 项目统一使用的 Java 版本，供编译插件和 Javadoc 插件共同引用。 -->
        <java.version>21</java.version>
        <!-- Redisson 3.17.7 之后使用 redisson-spring-data-3x 适配 Spring Boot 3.x。 -->
        <redisson-spring-boot.version>3.52.0</redisson-spring-boot.version>
        <!-- Spring Boot 3.x 使用 springdoc 2.x，springdoc 3.x 面向 Spring Boot 4.x -->
        <springdoc.version>2.9.0</springdoc.version>
        <mybatis.starter.version>3.0.5</mybatis.starter.version>
        <mybatis-plus-bom.version>3.5.14</mybatis-plus-bom.version>
        <!-- 与 MyBatis-Plus BOM 使用的版本保持一致。 -->
        <jsqlparser.version>5.2</jsqlparser.version>
        <pagehelper.starter.version>2.1.1</pagehelper.starter.version>
        <ojdbc.version>21.1.0.0</ojdbc.version>
        <sa-token.version>1.45.0</sa-token.version>
        <meilisearch.version>0.20.1</meilisearch.version>

        <hutool.version>5.8.47</hutool.version>
        <commons-validator.version>1.11.0</commons-validator.version>
        <commons.fileupload.version>1.6.0</commons.fileupload.version>
        <commons.io.version>2.22.0</commons.io.version>
        <commons.text.version>1.15.0</commons.text.version>
        <commons.collections4.version>4.6.0</commons.collections4.version>
        <commons.configuration2.version>2.15.1</commons.configuration2.version>
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <poi.version>5.4.1</poi.version>
        <pinyin4j.version>2.5.1</pinyin4j.version>
        <kaptcha.version>2.3.2</kaptcha.version>
        <jsoup.version>1.20.1</jsoup.version>
        <httpclient.version>4.5.14</httpclient.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok.version>1.18.46</lombok.version>
        <hessian.version>4.0.65</hessian.version>
        <jspecify.version>1.0.0</jspecify.version>

        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
        <maven-javadoc-plugin.version>3.11.3</maven-javadoc-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <!-- Checkstyle 插件及规则引擎版本。 -->
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <checkstyle.version>12.1.2</checkstyle.version>
        <!-- 子项目可在自己的根目录提供该文件，用于声明有明确理由的局部规则例外。 -->
        <lcxm.checkstyle.suppressions.file>${project.basedir}/checkstyle-suppressions.xml</lcxm.checkstyle.suppressions.file>
        <!-- 完整输出违规明细后使构建失败，作为统一代码规范门禁。 -->
        <checkstyle.failOnViolation>true</checkstyle.failOnViolation>
        <!-- 保持为 false，由 failOnViolation 在输出完整日志后决定是否使构建失败。 -->
        <checkstyle.failsOnError>false</checkstyle.failsOnError>
        <!-- 设置为 true 可临时跳过 Checkstyle。 -->
        <skip.checkstyle>false</skip.checkstyle>
        <spotbugs-maven-plugin.version>4.10.3.0</spotbugs-maven-plugin.version>
        <spotbugs.version>4.9.8</spotbugs.version>
        <!-- SpotBugs 分析并写入报告的最低优先级，子项目可按需覆盖。 -->
        <spotbugs.threshold>Medium</spotbugs.threshold>
        <!-- SpotBugs 使构建失败的最低优先级，子项目可按需覆盖。 -->
        <spotbugs.failThreshold>Medium</spotbugs.failThreshold>
        <!-- skip.spotbugs=true 可在子项目或命令行中跳过 SpotBugs 检查。 -->
        <skip.spotbugs>false</skip.spotbugs>
        <!-- skip.test=true 可在子项目或命令行中跳过 Surefire 测试。 -->
        <skip.test>false</skip.test>
    </properties>

